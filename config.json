{
  "$schema": "https://opencode.ai/config.json",
  "share": "disabled",
  "permission": {
    "bash": {
      "*": "allow",
      "ssh*": "ask",
      "scp*": "ask",
      "ansible*": "ask",
      "ansible-playbook*": "ask",
      "ansible-vault*": "deny",
      "git push*": "ask",
      "sudo*": "ask"
    },
    "read": {
      "*": "allow",
      "**/vault.yml": "deny",
      "**/.vault_pass": "deny",
      "**/.env": "deny",
      "**/.gitconfig": "deny",
      "~/tmp/**": "allow",
      "/tmp/**": "allow"
    },
    "edit": {
      "*": "allow",
      "**/vault.yml": "deny",
      "**/.vault_pass": "deny",
      "**/.env": "deny",
      "**/.gitconfig": "deny",
      "~/tmp/**": "allow",
      "/tmp/**": "allow"
    }
  },
  "shell": "/bin/bash"
}
